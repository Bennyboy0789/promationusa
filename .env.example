# Copy to `.env.local` (git-ignored) and fill in. Every variable here is
# optional — the site builds and runs without any of them, it just cannot
# measure conversions or deliver enquiries by email until they are set.

# ---------------------------------------------------------------------------
# Conversion measurement
# ---------------------------------------------------------------------------
# Google Tag Manager container. When empty, no tag is loaded at all — no
# script request, no cookie. Conversion events are still pushed to
# `window.dataLayer`, so the moment this is set every CTA is already
# instrumented with no further code change.
#
# Create the property under PROMATION's own Google account so they own the
# data, then configure GA4 inside the container rather than in this repo.
#
# Events the site emits (configure these as GA4 conversions):
#   quote_submit, quick_rfq_submit, phone_click, email_click, trial_request,
#   store_enquiry, spec_download, form_start, form_abandon, cta_click
NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# Enquiry delivery  (/api/enquiry)
# ---------------------------------------------------------------------------
# Without RESEND_API_KEY *and* ENQUIRY_FROM the endpoint answers 503 and both
# forms fall back to opening the visitor's mail client. That fallback is the
# behaviour the site had before the endpoint existed: it loses mobile users,
# so treat these as launch blockers rather than nice-to-haves.
#
# ENQUIRY_FROM must be on a domain verified in Resend, or delivery is rejected.
RESEND_API_KEY=
ENQUIRY_FROM="PROMATION USA <website@promationusa.com>"

# Where enquiries land. Defaults to the address published on the site.
ENQUIRY_TO=
